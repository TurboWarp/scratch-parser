{
  "name": "scratch-parser",
  "description": "Parser for Scratch projects",
  "author": "MIT Media Lab",
  "license": "MPL-2.0",
  "homepage": "https://github.com/LLK/scratch-parser#readme",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLK/scratch-parser.git"
  },
  "scripts": {
    "test:lint": "eslint . --ext=js",
    "test:unit": "node --test test/unit/*.js",
    "test:integration": "node --test test/integration/*.js",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/unit/*.js test/integration/*.js",
    "test": "npm run test:unit && npm run test:integration",
    "build:validators": "node scripts/build-validators.js"
  },
  "dependencies": {
    "@turbowarp/json": "^0.1.1",
    "@turbowarp/jszip": "^3.11.0",
    "@turbowarp/sb3fix": "^0.5.0",
    "ajv": "8.20.0",
    "pify": "4.0.1"
  },
  "devDependencies": {
    "babel-eslint": "10.1.0",
    "eslint": "^8.0.0",
    "eslint-config-scratch": "9.0.3",
    "glob": "^7.0.6"
  },
  "engines": {
    "node": ">=8.0"
  },
  "version": "0.0.0-development"
}
